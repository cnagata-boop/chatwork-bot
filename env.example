# ===== 記事を書く AI =====
# どちらか片方のキーを入れれば、それが使われます。
# 両方入れたときや、明示したいときは LLM_PROVIDER に claude / gemini を書きます。
LLM_PROVIDER=

# --- 無料で回す場合（Google AI Studio の無料枠） ---
# https://aistudio.google.com/apikey でキーを取得（クレジットカード不要）
GEMINI_API_KEY=
# 無料枠は Flash 系のみ。使えるモデル名は `npm run note -- models` で確認できます
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=4000

# --- 品質を上げたい場合（従量課金・1記事5〜15円） ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4000

# ===== note ログイン =====
# 手動ログイン（npm run note:login）でCookieを保存する運用を推奨。
# メール/パスワードを入れておくと、Cookieが切れたとき自動で入り直す（2段階認証を使っていない場合のみ）
NOTE_EMAIL=
NOTE_PASSWORD=
# draft … 下書き保存で止める（既定・おすすめ）/ publish … そのまま公開する
NOTE_PUBLISH_MODE=draft
NOTE_HEADLESS=true
NOTE_TIMEOUT_MS=45000
NOTE_MAX_TAGS=5
# 全記事の末尾に入れる導線。有料記事やメンバーシップに繋ぐ1〜2行を書く
# 例: 毎月の経理を30分で終わらせるテンプレは、メンバーシップで配っています。
NOTE_FOOTER=
# Playwright が用意する Chromium ではなく、自前の Chromium を使う場合のパス
NOTE_BROWSER_PATH=

# ===== お知らせ（任意・既定はオフ） =====
# 何も入れなければ通知しません（ログに残るだけ）。
# 毎朝 note アプリの「下書き」を見る運用なら、ここは空のままでOK。
# LINE に飛ばす場合（LINE公式アカウント / Messaging API のトークン）
LINE_CHANNEL_ACCESS_TOKEN=
# 送り先のユーザーID。空のままでよい（友だち全員＝自分に届く）
LINE_TO=
# Slack や Discord に飛ばす場合の Incoming Webhook URL
NOTIFY_WEBHOOK_URL=

# ===== 記事の中身 =====
# 空にしておけば、下の既定値（ひとり社長・個人事業主向け）で書きます。
CONTENT_THEME=ひとりで経理を回す人の作業を、AIとツールで減らす方法
# 読者は1人に絞るほど文章が安定します
CONTENT_AUDIENCE=社員数人の会社のひとり社長、または個人事業主。経理は自分か家族がやっていて、会計ソフトは入れたが使いこなせていない。税理士はいるが月1回しか会わない
# 個人アカウントとしての発信。勤務先や顧問先の名前は出さない
CONTENT_PERSONA=小さな会社の経理を実務で回してきた人。肩書きではなく作業内容で語り、勤務先や取引先の名前は出さない
CONTENT_TONE=読者1人に話しかける口調。手順と数字が具体的で、読んだその日に真似できる
CONTENT_MIN_CHARS=1200
CONTENT_MAX_CHARS=3000
# true にすると「無料パート＋有料パート」構成で書く（値段設定は note の画面で手動）
CONTENT_PAID=false
NOTE_PRICE=300

# ===== 自動実行（サーバで常駐させる場合） =====
AUTO_POST_ENABLED=false
AUTO_POST_CRON=0 8 * * *
TZ=Asia/Tokyo
# /cron/post などを外から叩くときの合言葉
CRON_SECRET=

PORT=3000
