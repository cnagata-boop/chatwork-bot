# ===== Claude =====
CLAUDE_API_KEY=ここにClaude APIキーを入れる
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4000

# ===== note ログイン =====
# 手動ログイン（npm run note:login）でCookieを保存する運用を推奨。
# メール/パスワードを入れておくと、Cookieが切れたとき自動で入り直す（2段階認証を使っていない場合のみ）
NOTE_EMAIL=
NOTE_PASSWORD=
# draft … 下書き保存で止める（既定・おすすめ）/ publish … そのまま公開する
NOTE_PUBLISH_MODE=draft
NOTE_HEADLESS=true
NOTE_TIMEOUT_MS=45000
NOTE_MAX_TAGS=5
# 全記事の末尾に入れる導線（メンバーシップ・マガジン・Amazonアソシエイトなど）
NOTE_FOOTER=
# Playwright が用意する Chromium ではなく、自前の Chromium を使う場合のパス
NOTE_BROWSER_PATH=

# ===== お知らせ（任意） =====
# LINE に飛ばす場合（LINE公式アカウント / Messaging API のトークン）
LINE_CHANNEL_ACCESS_TOKEN=
# 送り先のユーザーID。空のままでよい（友だち全員＝自分に届く）
LINE_TO=
# Slack や Discord に飛ばす場合の Incoming Webhook URL
NOTIFY_WEBHOOK_URL=

# ===== 記事の中身 =====
CONTENT_THEME=経理業務の効率化とAI活用
CONTENT_AUDIENCE=中小企業の経理担当者・個人事業主
CONTENT_PERSONA=中小企業の経理・バックオフィス改善を手伝ってきた実務家
CONTENT_TONE=具体例が多く、手を動かせる実務寄りの語り口
CONTENT_MIN_CHARS=1200
CONTENT_MAX_CHARS=3000
# true にすると「無料パート＋有料パート」構成で書く（値段設定は note の画面で手動）
CONTENT_PAID=false
NOTE_PRICE=300

# ===== 自動実行（サーバで常駐させる場合） =====
AUTO_POST_ENABLED=false
AUTO_POST_CRON=0 8 * * *
TZ=Asia/Tokyo
# /cron/post などを外から叩くときの合言葉
CRON_SECRET=

PORT=3000
